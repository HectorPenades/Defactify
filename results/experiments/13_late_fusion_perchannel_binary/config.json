{
  "experiment_name": "13_late_fusion_perchannel_binary",
  "description": "Late fusion: RGB ResNet50 + per-channel FFT ResNet50 \u2192 MLP \u2014 binary (real vs AI)",
  "seed": 42,
  "device": "cuda:0",
  "num_workers": 4,
  "dataset": {
    "name": "defactify_hf",
    "split": "train",
    "mode": "fusion_late",
    "hf_repo": "Rajarshi-Roy-research/Defactify_Image_Dataset",
    "fft_channels": 3
  },
  "preprocessing": {
    "image_size": 224,
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ],
    "resize_method": "aspect_ratio_pad"
  },
  "augmentations": {
    "enabled": true,
    "random_flip": 0.5,
    "color_jitter": 0.2,
    "blur": 0.1,
    "brightness": 0.1,
    "contrast": 0.1
  },
  "model": {
    "architecture": "late_fusion",
    "pretrained": true,
    "num_classes": 2,
    "dropout": 0.5,
    "vlm_backbone": "clip-vit-b32",
    "vlm_classifier_type": "mlp"
  },
  "training": {
    "optimizer": "adam",
    "lr": 0.0005,
    "weight_decay": 1e-05,
    "batch_size": 16,
    "num_epochs": 50,
    "early_stopping_patience": 10,
    "lr_scheduler": "reduce_on_plateau",
    "scheduler_factor": 0.5,
    "scheduler_patience": 5
  },
  "loss": {
    "type": "weighted_ce",
    "handle_imbalance": "weighted"
  },
  "task": "binary",
  "cache": {
    "enable_fft_cache": true,
    "enable_embeddings_cache": true,
    "force_recompute": false,
    "cache_dir": "./data/cache"
  },
  "output": {
    "results_dir": "./results/experiments",
    "save_checkpoint": true,
    "save_best_only": true,
    "save_predictions": true,
    "save_confusion_matrix": true,
    "save_metrics_every_epoch": true
  }
}